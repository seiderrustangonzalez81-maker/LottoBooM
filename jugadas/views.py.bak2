# ============================================================
# HELPERS
# ============================================================
def _get_telefono(user):
    if not user:
        return ''
    try:
        perfil = getattr(user, 'perfil', None)
        if perfil:
            telf = getattr(perfil, 'telefono', None)
            if telf:
                return str(telf).strip()
    except Exception:
        pass
    return str(getattr(user, 'telefono', '') or '').strip()


# ============================================================
# HELPERS DE CLIENTES OFFLINE
# ============================================================
PREFIJO_BLOQUE_OFFLINE = '+5350'
MAX_DENTRO_BLOQUE      = 9_999_999
BLOQUES_DISPONIBLES    = 10


def _siguiente_telefono_offline():
    """
    Genera el siguiente teléfono del rango offline.
    Bloque actual: +5350XXXXXXX (10M).
    """
    for bloque in range(BLOQUES_DISPONIBLES):
        prefijo = f"+535{bloque}"
        existentes = ClienteOffline.objects.filter(
            telefono_offline__startswith=prefijo
        ).values_list('telefono_offline', flat=True)

        max_n = -1
        for tel in existentes:
            try:
                n = int(tel[len(prefijo):])
                if n > max_n:
                    max_n = n
            except (ValueError, IndexError):
                continue

        if max_n < MAX_DENTRO_BLOQUE:
            return f"{prefijo}{max_n + 1:07d}"

    raise RuntimeError('Rango completo de teléfonos offline agotado (100M usados)')


def _get_banco_de(user):
    """Devuelve el banco superior del user, si existe. None si no hay."""
    if not user or not user.id:
        return None
    sub = Subordinacion.objects.filter(
        subordinado=user, activo=True
    ).select_related('jefe').first()
    if sub and sub.jefe:
        if sub.jefe.is_superuser or sub.jefe.roles.filter(tipo='banco', activo=True).exists():
            return sub.jefe
    return None

def _construir_clientes_visibles(user):
    """
    Personas visibles para `user` al apostar:
      - superadmin → todos los User activos
      - banco      → subordinados directos + subordinados de sus comerciales + users a los que fondeó
      - comercial  → subordinados directos + users a los que fondeó
      - cliente    → gestores activos a los que puede apostar (superadmins, bancos, comerciales)
    Un cliente offline NO se comparte entre gestores (creado = dueño).
    """
    es_superadmin = user.is_superuser or user.roles.filter(tipo='superadmin', activo=True).exists()
    es_banco      = user.roles.filter(tipo='banco', activo=True).exists()
    es_comercial  = user.roles.filter(tipo='comercial', activo=True).exists()
    es_cliente    = user.roles.filter(tipo='cliente', activo=True).exists()

    # ═══════════════════════════════════════════════════════════
    # CASO ESPECIAL: CLIENTE → devolver los gestores a los que puede apostar
    # ═══════════════════════════════════════════════════════════
    if es_cliente and not (es_superadmin or es_banco or es_comercial):
        gestor_ids = (
            Rol.objects
            .filter(tipo__in=['superadmin', 'banco', 'comercial'], activo=True)
            .values_list('usuario_id', flat=True)
            .distinct()
        )
        gestores = (
            User.objects
            .filter(id__in=gestor_ids, is_active=True)
            .exclude(id=user.id)
        )

        result = []
        for u in gestores:
            rol_obj = u.roles.filter(activo=True).first()
            result.append({
                'id': u.id,
                'nombre': u.username,
                'telefono': _get_telefono(u),
                'saldo_total': 0.0,
                'saldo_real': 0.0,
                'bonos_activos': 0.0,
                'rol': rol_obj.tipo if rol_obj else ('superadmin' if u.is_superuser else 'gestor'),
                'es_offline': False,
            })

        result.sort(key=lambda c: c['nombre'].lower())
        return result

    # ═══════════════════════════════════════════════════════════
    # CASO NORMAL: gestores → devolver sus clientes
    # ═══════════════════════════════════════════════════════════
    if not (es_superadmin or es_banco or es_comercial):
        return []

    ids = set()

    if es_superadmin:
        ids.update(
            User.objects.filter(is_active=True).exclude(id=user.id)
            .values_list('id', flat=True)
        )
    else:
        ids.update(
            Subordinacion.objects.filter(jefe=user, activo=True)
            .values_list('subordinado_id', flat=True)
        )

        if es_banco:
            comerciales_ids = Subordinacion.objects.filter(
                jefe=user, activo=True
            ).values_list('subordinado_id', flat=True)
            ids.update(
                Subordinacion.objects.filter(
                    jefe__in=comerciales_ids, activo=True
                ).values_list('subordinado_id', flat=True)
            )

        ids.update(
            Fondo.objects.filter(asignado_por=user, activo=True)
            .values_list('usuario_id', flat=True).distinct()
        )

        if es_comercial:
            rol = user.roles.filter(tipo='comercial', activo=True).first()
            if rol and rol.banco_asignado_id:
                if Fondo.objects.filter(
                    usuario=user, asignado_por=rol.banco_asignado, activo=True
                ).exists():
                    ids.add(rol.banco_asignado_id)

        # Superadmins que me fondearon
        if es_comercial or es_banco:
            sa_ids = list(
                User.objects.filter(roles__tipo='superadmin', roles__activo=True)
                .values_list('id', flat=True)
            )
            if sa_ids:
                ids.update(
                    Fondo.objects.filter(
                        usuario=user, asignado_por__in=sa_ids, activo=True
                    ).values_list('asignado_por_id', flat=True).distinct()
                )

    ids.discard(user.id)

    if not ids:
        return []

    result = []
    for u in User.objects.filter(id__in=ids, is_active=True).distinct():
        if es_superadmin:
            saldo_total = Fondo.objects.filter(
                usuario=u, activo=True
            ).aggregate(t=Sum('monto'))['t'] or 0
            bonos = Bono.objects.filter(usuario=u, estado='activo')
        else:
            saldo_total = Fondo.objects.filter(
                usuario=u, asignado_por=user, activo=True
            ).aggregate(t=Sum('monto'))['t'] or 0
            bonos = Bono.objects.filter(usuario=u, asignado_por=user, estado='activo')

        total_bonos = sum(b.saldo_restante for b in bonos)
        rol_obj = u.roles.filter(activo=True).first()
        es_offline = hasattr(u, 'cliente_offline')

        result.append({
            'id': u.id,
            'nombre': u.username,
            'telefono': _get_telefono(u),
            'saldo_total': float(saldo_total),
            'saldo_real': float(saldo_total + total_bonos),
            'bonos_activos': float(total_bonos),
            'rol': rol_obj.tipo if rol_obj else ('superadmin' if u.is_superuser else 'cliente'),
            'es_offline': es_offline,
        })

    result.sort(key=lambda c: c['nombre'].lower())
    return result
