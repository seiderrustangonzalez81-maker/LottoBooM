# sorteos/management/commands/sincronizar_formas.py
import json
from django.core.management.base import BaseCommand
from django.db import transaction
from sorteos.models import Sorteo, SorteoFormaJuego
from jugadas.models import FormaJuego

class Command(BaseCommand):
    help = 'Sincroniza SorteoFormaJuego desde un archivo JSON de fixtures'

    def add_arguments(self, parser):
        parser.add_argument('json_file', type=str, help='Ruta al archivo JSON con los sorteos')

    def handle(self, *args, **options):
        json_path = options['json_file']
        with open(json_path, 'r', encoding='utf-8') as f:
            data = json.load(f)

        formas_dict = {f.nombre: f for f in FormaJuego.objects.all()}
        no_encontradas = []

        with transaction.atomic():
            for item in data:
                if item.get('model') != 'sorteos.sorteo':
                    continue
                pk = item.get('pk')
                fields = item.get('fields', {})
                try:
                    sorteo = Sorteo.objects.get(pk=pk)
                except Sorteo.DoesNotExist:
                    self.stdout.write(self.style.WARNING(f"Sorteo con pk {pk} no encontrado. Se omite."))
                    continue

                # Desactivar todas las relaciones previas
                SorteoFormaJuego.objects.filter(sorteo=sorteo).update(activo=False)

                # Activar las formas del JSON
                formas_list = fields.get('formas_juego', [])
                for forma_nombre in formas_list:
                    forma = formas_dict.get(forma_nombre)
                    if forma:
                        SorteoFormaJuego.objects.update_or_create(
                            sorteo=sorteo,
                            forma_juego=forma,
                            defaults={'activo': True}
                        )
                        self.stdout.write(f"✅ Activada: {sorteo.nombre} - {forma.nombre}")
                    else:
                        no_encontradas.append(f"{sorteo.nombre}: {forma_nombre}")

            if no_encontradas:
                self.stdout.write(self.style.WARNING("⚠️ Formas no encontradas:"))
                for item in no_encontradas:
                    self.stdout.write(f"  - {item}")

        self.stdout.write(self.style.SUCCESS("🎯 Sincronización completada."))